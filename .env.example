# cTrader Open API — NEVER commit real values
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# demo | live. Keep demo during development.
CTRADER_ENV=demo

# Optional. If empty, Priore uses the first account returned by the token.
CTRADER_ACCOUNT_ID=

# Market
CTRADER_SYMBOL=XAUUSD
M5_HISTORY_COUNT=300
M15_HISTORY_COUNT=300

# Strategy
ATR_PERIOD=14
LEVEL_LOOKBACK=12
MIN_RR=1.8

# Firebase Cloud Messaging
# Keep the same topic in the Android app.
FIREBASE_TOPIC=priore-xau

# Choose ONE server authentication method for Firebase Admin:
# 1) Preferred on Google Cloud: Application Default Credentials.
# 2) Local/VPS: set GOOGLE_APPLICATION_CREDENTIALS to the private service-account JSON path.
# 3) Hosting secret store: place the entire JSON object in FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
