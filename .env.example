# cTrader Open API — NEVER commit real values
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# demo | live. Keep demo during development.
CTRADER_ENV=demo

# Optional. If empty, Priore uses the first account returned by the token.
CTRADER_ACCOUNT_ID=

# Market
CTRADER_SYMBOL=XAUUSD
M5_HISTORY_COUNT=300
M15_HISTORY_COUNT=300

# Strategy
ATR_PERIOD=14
LEVEL_LOOKBACK=12
MIN_RR=1.8

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
